# Copy to .env.local for local builds. Production values live in
# .github/workflows/deploy-pages.yml (env block). Empty = feature hidden.
NEXT_PUBLIC_SITE_URL=https://qo.ax
NEXT_PUBLIC_BASE_PATH=

# Social channels (full URLs). Rendered in the footer and schema.org sameAs only when set.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_VIBER=

# Google Search Console "HTML tag" verification: paste only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
